# Optional live NVIDIA inference. Copy to .env.local and add your key locally.
# Keep .env.local ignored; never put a key in browser code or chat.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional local demo port. The server always binds to 127.0.0.1.
DEMO_WEB_PORT=4173
